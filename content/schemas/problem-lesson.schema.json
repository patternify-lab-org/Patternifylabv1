{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://visual-dsa.dev/schemas/problem-lesson.schema.json",
  "title": "Visual DSA guided problem lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "introduction", "stages", "approachAnalysis", "challenge"],
  "properties": {
    "title": { "type": "string", "minLength": 3 },
    "introduction": { "type": "string", "minLength": 20 },
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "teachingPoints"],
        "properties": {
          "id": { "enum": ["understand", "recount", "discover", "pattern", "challenge"] },
          "title": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 20 },
          "teachingPoints": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 10 }
          }
        }
      }
    },
    "approachAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["straightforward", "optimized", "nextStep"],
      "properties": {
        "straightforward": { "$ref": "#/$defs/approach" },
        "optimized": { "$ref": "#/$defs/approach" },
        "nextStep": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "body"],
          "properties": {
            "title": { "type": "string", "minLength": 3 },
            "body": { "type": "string", "minLength": 20 }
          }
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "windowSize", "hints"],
      "properties": {
        "input": { "type": "string", "pattern": "^[BW]+$", "maxLength": 100 },
        "windowSize": { "type": "integer", "minimum": 1, "maximum": 100 },
        "hints": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 10 }
        }
      }
    }
  },
  "$defs": {
    "approach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "extraSpace", "context"],
      "properties": {
        "time": { "type": "string", "minLength": 2 },
        "extraSpace": { "type": "string", "minLength": 2 },
        "context": { "type": "string", "minLength": 20 }
      }
    }
  }
}
